# ============================================================
#  bothostgtagame v2 — Castle Host (cp.castle-host.com)
#  Скопируйте этот файл в .env.local и заполните РЕАЛЬНЫЕ значения.
#  !!! НИКОГДА не коммитьте .env.local в Git! Файлы .env* уже
#  заблокированы в .gitignore.
# ============================================================

# --- Учётные данныеCastle Host (привилегированный режим: только ваш личный аккаунт) ---
CASTLE_LOGIN=your@email.com
CASTLE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# ID сервера в панели (виден в URL страницы сервера, например cp.castle-host.com/servers/12345)
CASTLE_SERVER_ID=12345

# --- Адрес панели (по умолчанию менять не нужно) ---
CASTLE_BASE_URL=https://cp.castle-host.com

# --- Продакшен-режим (HTTP без эмуляции) ---
# Ключ шифрования сохранённой HTTP-сессии (cookies). ОБЯЗАТЕЛЕН.
# Сгенерируйте случайный: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_RANDOM_64_HEX
# Файл профиля эндпоинтов панели (создаётся командой `npm run discover`,
# можно править вручную при смене вёрстки панели).
API_PROFILE=./api-profile.json
# true  = если панель не даст выполнить действие по HTTP, бот разово
#         использует резервный браузерный цикл (нужен playwright-core + Chrome)
# false = строго только HTTP; при проблемах придёт уведомление
ALLOW_BROWSER_FALLBACK=true

# --- Браузер (только для fallback/отладки) ---
# true  = запускать браузер без графического интерфейса (для VPS)
# false = показать окно (удобно для отладки и ручного прохождения капчи)
HEADLESS=true
# Путь к исполняемому файлу Chrome/Chromium (если не задан — playwright-core
# попробует найти системный Chrome или Playwright-браузер).
CHROME_PATH=

# --- Хранение сессии ---
# Каталог с localStorage/cookies авторизованной сессии (НЕ коммитится!).
SESSION_DIR=./session

# --- Расписание (МСК) ---
TZ=Europe/Moscow
# Ежедневное включение сервера: 00:01 МСК (минута час * * *)
START_CRON=1 0 * * *
# Проверка статуса + продления: каждый час в 5-я минута
CHECK_CRON=5 * * * *
# Продлевать аренду, если до окончания осталось меньше этого числа часов
RENEW_THRESHOLD_HOURS=24
# На сколько дней продлевать
RENEW_DAYS=7

# --- Human-like поведение (антибан) ---
# Мин/макс случайной паузы между действиями, мс
HUMAN_DELAY_MIN_MS=800
HUMAN_DELAY_MAX_MS=3500
# Повторять неудачное действие (включение/оплата) через N минут
RETRY_AFTER_MIN=5
# Максимум повторных попыток за один цикл
MAX_RETRIES=3

# --- Логирование и уведомления ---
LOG_LEVEL=info            # debug | info | warn | error
TELEGRAM_BOT_TOKEN=       # токен @BotFather (необязательно)
TELEGRAM_CHAT_ID=         # ваш chat_id (необязательно)
# Простой webhook для уведомлений (JSON POST {text}) — необязательно
WEBHOOK_URL=

# --- Капча ---
# Если панель покажет reCAPTCHA/hCaptcha, решатель можно подключить здесь.
# Пример: CAPTCHA_23_CAPTCHA_KEY=<ключ баланса 2captcha> (пусто = капчу не решать,
# бот сохранит скриншот и отправит уведомление с просьбой пройти её вручную).
CAPTCHA_23_CAPTCHA_KEY=
